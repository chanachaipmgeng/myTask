# Copy to .env and set the local Syncfusion license. .env is gitignored.
# Used by npm start/build and by docker compose (web build-arg).
SYNCFUSION_LICENSE=

# Server (Nest) — also readable from server/.env
# Local: localhost:5433. Docker compose sets DATABASE_URL to db:5432 for the api service.
DATABASE_URL=postgres://manday:manday@localhost:5433/manday
APP_URL=http://127.0.0.1:4200
HOST=127.0.0.1
PORT=3000
TOKEN_ENC_KEY=dev-only-insecure-key-change-me-please
AUTH_DEV_LOGIN=true
SESSION_DAYS=7

# GitLab OAuth (login) & MR Sync (P2.3). Optional while AUTH_DEV_LOGIN=true.
GITLAB_URL=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
BOOTSTRAP_ADMIN_GITLAB_USERNAMES=
# Personal/Project Access Token and comma-separated Project IDs for MR sync (/mygit & /integrations)
GITLAB_API_TOKEN=
GITLAB_PROJECT_IDS=

# OpenProject (myProject). Leave empty to configure later in Integrations UI.
OPENPROJECT_URL=
OPENPROJECT_API_TOKEN=
# PATCH assignee and dates back to OpenProject. Default off.
# When true, /queue shows a confirm dialog before assign if the ticket has opId.
OPENPROJECT_WRITEBACK=false
OPENPROJECT_SYNC_CRON=*/15 * * * *

# Microsoft Teams Incoming Webhook (P2.2). Leave empty to configure in /integrations or use dry-run mode on /teams.
TEAMS_WEBHOOK_URL=
TEAMS_DEFAULT_CHANNEL=scorecard-alerts

# --- Staging / Production Checklist (P4) ---
# APP_URL=https://scorecard.example.com
# AUTH_DEV_LOGIN=false
# TOKEN_ENC_KEY=<32+ random characters>
# OPENPROJECT_WRITEBACK=false (enable only after verifying statusMap & user mapping)
