# Copy to .env and set the local Syncfusion license. .env is gitignored.
# Used by npm start/build and by docker compose (web build-arg).
SYNCFUSION_LICENSE=

# Server (Nest) — also readable from server/.env
# Local: localhost:5433. Docker compose sets DATABASE_URL to db:5432 for the api service.
DATABASE_URL=postgres://manday:manday@localhost:5433/manday
APP_URL=http://127.0.0.1:4200
HOST=127.0.0.1
PORT=3000
TOKEN_ENC_KEY=dev-only-insecure-key-change-me-please
AUTH_DEV_LOGIN=true
SESSION_DAYS=7

# GitLab OAuth (login). Optional while AUTH_DEV_LOGIN=true.
GITLAB_URL=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
BOOTSTRAP_ADMIN_GITLAB_USERNAMES=

# OpenProject (myProject). Leave empty to configure later in Integrations UI.
OPENPROJECT_URL=
OPENPROJECT_API_TOKEN=
# PATCH assignee back to OpenProject after assign. Default off.
# When true, /queue shows a confirm dialog before assign if the ticket has opId.
OPENPROJECT_WRITEBACK=false
OPENPROJECT_SYNC_CRON=*/15 * * * *

# P2 (not wired yet): Incoming webhook for real Teams notify from /teams drafts.
# TEAMS_WEBHOOK_URL=
