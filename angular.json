{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "bb806f19-5219-4d69-96e5-8e3b3c0596f2"
  },
  "newProjectRoot": "projects",
  "projects": {
    "manday-scorecard": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "tailwind3.css",
                "input": "node_modules/@syncfusion/ej2-tailwind3-theme/styles",
                "output": "assets/themes"
              },
              {
                "glob": "tailwind3-dark.css",
                "input": "node_modules/@syncfusion/ej2-tailwind3-dark-theme/styles",
                "output": "assets/themes"
              }
            ],
            "styles": [
              "node_modules/@fontsource/sarabun/latin-400.css",
              "node_modules/@fontsource/sarabun/latin-600.css",
              "node_modules/@fontsource/sarabun/latin-700.css",
              "node_modules/@fontsource/sarabun/thai-400.css",
              "node_modules/@fontsource/sarabun/thai-600.css",
              "node_modules/@fontsource/sarabun/thai-700.css",
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "6.5MB",
                  "maximumError": "8MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "28kB",
                  "maximumError": "36kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "manday-scorecard:build:production"
            },
            "development": {
              "buildTarget": "manday-scorecard:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
